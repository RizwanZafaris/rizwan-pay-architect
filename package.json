{
  "name": "rzifi-site",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "build:static": "bun run build && bun scripts/build-static.ts",
    "seo:audit": "bun scripts/seo-audit.ts",
    "seo:llms": "bun scripts/generate-llms.ts",
    "seo:indexnow": "bun scripts/indexnow-submit.ts",
    "seo:check-live": "bun scripts/check-live.ts",
    "seo:og-image": "bun scripts/generate-og.ts",
    "resume:pdf": "python3 scripts/generate-resume-pdf.py",
    "content:validate": "bun scripts/validate-content.ts",
    "content:backlog": "bun scripts/generate-400-backlog.ts",
    "content:topic-map": "bun scripts/generate-topic-map.ts",
    "deploy:git-static": "bash scripts/deploy-git-static.sh",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "vendor:consent": "cp node_modules/vanilla-cookieconsent/dist/cookieconsent.umd.js node_modules/vanilla-cookieconsent/dist/cookieconsent.css public/vendor/",
    "check:facts": "bun scripts/check-facts.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/instrument-serif": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "@tanstack/zod-adapter": "^1.167.0",
    "clsx": "^2.1.1",
    "dotted-map": "^3.1.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vanilla-cookieconsent": "^3.1.0",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  }
}
