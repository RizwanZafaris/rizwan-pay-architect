# Copy to .env.local for dev, or set in your deployment environment.
# All client-exposed vars MUST be prefixed VITE_ to be inlined by Vite at build time.

# ─── Site identity ───────────────────────────────────────────────────────────
# Used in canonical URLs, og:url, sitemap.xml, and all absUrl() calls.
# Production canonical domain.
VITE_SITE_URL=https://rzifi.com

# Default Open Graph card image (1200×630). Replace with a real branded card
# once one is hosted on R2, Cloudinary, or your own assets bucket.
VITE_OG_IMAGE_URL=

# ─── Contact form ────────────────────────────────────────────────────────────
# Web3Forms access key (https://web3forms.com — free, no sign-up email).
# When set, the contact form POSTs to Web3Forms and the inbox is your email.
# When unset, the form falls back to opening the visitor's mail client (mailto:).
#
# Drop-in alternatives (adjust CONTACT_ENDPOINT + payload in contact.tsx):
#   - Formspree:   set the form's `action` to your Formspree endpoint
#   - Getform:     same pattern
#   - Cloudflare Worker / custom backend: write a server function
VITE_CONTACT_ACCESS_KEY=

# ─── Optional analytics / webmaster tools ────────────────────────────────────
# Current architecture: GA4, Google Ads, and LinkedIn Insight load directly in
# __root.tsx behind Consent Mode / cookie-category gates. The retired GTM
# container is not loaded; do not mirror these tags in a second pipeline.
# Production GA4 defaults to G-F1NK5FJYJY.
VITE_GA_MEASUREMENT_ID=G-F1NK5FJYJY

# Bing Webmaster Tools verification meta:
#   <meta name="msvalidate.01" content="...">
VITE_BING_SITE_VERIFICATION=

# Microsoft Clarity heatmaps/session recordings. Leave empty until you create
# a Clarity project and are comfortable with session-recording privacy.
VITE_MICROSOFT_CLARITY_ID=

# Plausible privacy-friendly analytics, optional. Leave empty when direct GA4
# is the only required traffic source of truth.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
