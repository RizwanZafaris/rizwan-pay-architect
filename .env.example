# Copy to .env.local for dev, or set in your deployment environment.
# All client-exposed vars MUST be prefixed VITE_ to be inlined by Vite at build time.

# ─── Site identity ───────────────────────────────────────────────────────────
# Used in canonical URLs, og:url, sitemap.xml, and all absUrl() calls.
# Set this to your custom domain once it's live (e.g. https://rizwanzafar.com).
VITE_SITE_URL=https://rizwan-pay-architect.lovable.app

# Default Open Graph card image (1200×630). Replace with a real branded card
# once one is hosted on R2, Cloudinary, or your own assets bucket.
VITE_OG_IMAGE_URL=

# ─── Contact form ────────────────────────────────────────────────────────────
# Web3Forms access key (https://web3forms.com — free, no sign-up email).
# When set, the contact form POSTs to Web3Forms and the inbox is your email.
# When unset, the form falls back to opening the visitor's mail client (mailto:).
#
# Drop-in alternatives (adjust CONTACT_ENDPOINT + payload in contact.tsx):
#   - Formspree:   set the form's `action` to your Formspree endpoint
#   - Getform:     same pattern
#   - Cloudflare Worker / Lovable backend: write a server function
VITE_CONTACT_ACCESS_KEY=
