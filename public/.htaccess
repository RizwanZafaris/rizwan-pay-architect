# Hostinger / Apache config for the prerendered static build.
# Order matters: canonical-host and HTTPS redirects MUST run before the
# directory-serving rules. The directory rules end with [L] which would
# otherwise short-circuit the rewrite engine and let www / http traffic
# render with the wrong host.

# ────────────────────────────────────────────────────────────────────────────
# 1. Canonical host + HTTPS  (runs FIRST)
#    Apex `https://rzifi.com` is canonical. Everything else 301-redirects to
#    it in a single hop, preserving path + query string.
#    - http://rzifi.com/<x>       → https://rzifi.com/<x>
#    - http://www.rzifi.com/<x>   → https://rzifi.com/<x>
#    - https://www.rzifi.com/<x>  → https://rzifi.com/<x>
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → apex (single hop, drops www and forces https).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # http → https on the canonical host (apex).
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Semantic / legacy redirects
#    The public navigation labels this body of work as case studies, while the
#    canonical content lives under /product-work/. Preserve old or intuitive
#    shared URLs without adding duplicate indexable pages.
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^case-studies/?$ /product-work/ [L,R=301]
  RewriteRule ^case-studies/(.+?)/?$ /product-work/$1/ [L,R=301]
  RewriteRule ^about/?$ /resume/ [L,R=301]
  # Guessable consulting URLs → the canonical advisory page.
  RewriteRule ^services/?$ /consulting/ [L,R=301]
  RewriteRule ^advisory/?$ /consulting/ [L,R=301]
  RewriteRule ^blog/agentic-payments-need-rails-not-demos/?$ /blog/agentic-commerce-visa-mastercard-payments/ [L,R=301]
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 3. Security headers
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 4. Trailing-slash policy
#    Hostinger serves prerendered directories at /<route>/index.html, so the
#    canonical URL for every non-root route ends with a trailing slash.
#    /resume          → 301 → /resume/        (canonical)
#    /blog/foo        → 301 → /blog/foo/      (canonical)
#    Skip rule for real files (`.htaccess`, `.webp`, `.css`, etc).
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the URI has no extension AND no trailing slash AND a matching directory
  # exists, redirect with a slash. Single 301 hop, preserves query.
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteRule ^(.+)$ /$1/ [L,R=301]
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 5. Pretty URLs → prerendered HTML  (runs AFTER redirects)
#    /resume/     → /resume/index.html
#    /blog/foo/   → /blog/foo/index.html
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request is for a real file or real directory, serve it.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, try appending /index.html.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # Final fallback: genuinely-missing paths return a REAL 404 (not a soft-404
  # serving the homepage at HTTP 200). The static export is JS-less, so there
  # are no client-only routes to preserve — every real route is a prerendered
  # file/dir matched above. ErrorDocument (§8) renders the branded, hard-
  # noindexed /404.html with the 404 status.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [L,R=404]
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 6. Compression — Brotli first, gzip fallback
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 7. Cache headers
#    - Hashed asset files (Vite outputs *-[hash].js / *-[hash].css): cache 1 year, immutable
#    - HTML: short cache, must-revalidate
#    - PDF, images, fonts: 30 days
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # Hashed bundles (Vite uses /assets/<name>-<hash>.<ext>)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/font-woff "access plus 30 days"
  ExpiresByType application/font-woff2 "access plus 30 days"

  # Images
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Resume PDF: recruiters must always get the current version — 1 hour, not
# the 30-day static-asset default (a stale resume circulated for weeks once).
<Files "Rizwan_Zafar_Resume.pdf">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>
<IfModule mod_expires.c>
  ExpiresByType image/x-icon "access plus 30 days"

  # PDFs
  ExpiresByType application/pdf "access plus 30 days"

  # HTML: short cache + revalidate
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/xml "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
  # Vite hashed assets — long cache + immutable
  <FilesMatch "\-[A-Za-z0-9_]{8,}\.(?:js|css|woff2?|png|jpg|jpeg|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Sitemap, robots, llms manifests
  <FilesMatch "(sitemap\.xml|robots\.txt|llms(-full)?\.txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 8. Pretty MIME types (Hostinger sometimes mis-types these)
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 9. Don't list directories
# ────────────────────────────────────────────────────────────────────────────
Options -Indexes

# ────────────────────────────────────────────────────────────────────────────
# 10. Custom 404 — branded, hard-noindexed page (prerendered to /404.html).
#    Pairs with the §3 final fallback so missing URLs return 404 (not a
#    soft-404 homepage at 200).
# ────────────────────────────────────────────────────────────────────────────
ErrorDocument 404 /404.html
