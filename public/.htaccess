# Hostinger / Apache config for the prerendered static build.
# Generated by scripts/build-static.ts at deploy time.

# ────────────────────────────────────────────────────────────────────────────
# 1. Pretty URLs → prerendered HTML
#    /about      → /about/index.html
#    /blog       → /blog/index.html
#    /blog/foo   → /blog/foo/index.html
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request is for a real file or real directory, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, try appending /index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # Final fallback: serve the root index.html (SPA-style client-side routing for
  # any route the prerender didn't produce). The client router will handle 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 2. Force HTTPS (Hostinger provides free SSL)
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 3. Compression — Brotli first, gzip fallback
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 4. Cache headers
#    - Hashed asset files (Vite outputs *-[hash].js / *-[hash].css): cache 1 year, immutable
#    - HTML: short cache, must-revalidate
#    - PDF, images, fonts: 30 days
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # Hashed bundles (Vite uses /assets/<name>-<hash>.<ext>)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/font-woff "access plus 30 days"
  ExpiresByType application/font-woff2 "access plus 30 days"

  # Images
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"

  # PDFs
  ExpiresByType application/pdf "access plus 30 days"

  # HTML: short cache + revalidate
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/xml "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
  # Vite hashed assets — long cache + immutable
  <FilesMatch "\-[A-Za-z0-9_]{8,}\.(?:js|css|woff2?|png|jpg|jpeg|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Sitemap, robots
  <FilesMatch "(sitemap\.xml|robots\.txt|llms\.txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 5. Pretty MIME types (Hostinger sometimes mis-types these)
# ────────────────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# ────────────────────────────────────────────────────────────────────────────
# 6. Don't list directories
# ────────────────────────────────────────────────────────────────────────────
Options -Indexes
